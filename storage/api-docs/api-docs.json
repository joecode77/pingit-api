        "/api/monitors": {
            "get": {
                "tags": [
                    "Monitors"
                ],
                "summary": "List all monitors for the authenticated user",
                "operationId": "b238bf9af384f617bb4c2bbc47fd076a",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter by status",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pending",
                                "up",
                                "down",
                                "degraded",
                                "paused"
                            ]
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by name or URL",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort field",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "name",
                                "created_at",
                                "last_checked_at"
                            ]
                        }
                    },
                    {
                        "name": "direction",
                        "in": "query",
                        "description": "Sort direction",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "asc",
                                "desc"
                            ]
                        }
                    },
                    {
                        "name": "tag",
                        "in": "query",
                        "description": "Filter by tag name",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of monitors"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Monitors"
                ],
                "summary": "Register a new URL to monitor",
                "operationId": "9e798d4fe6fd77ea752fde01ecbcc27b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "url"
                                ],
                                "properties": {
                                    "url": {
                                        "type": "string",
                                        "example": "https://example.com"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "My Website"
                                    },
                                    "check_interval": {
                                        "type": "integer",
                                        "maximum": 60,
                                        "minimum": 1,
                                        "example": 5
                                    },
                                    "threshold": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "example": 3
                                    },
                                    "response_time_threshold_ms": {
                                        "type": "integer",
                                        "example": 2000
                                    },
                                    "http_method": {
                                        "type": "string",
                                        "enum": [
                                            "GET",
                                            "HEAD"
                                        ],
                                        "example": "GET"
                                    },
                                    "follow_redirects": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Monitor created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
